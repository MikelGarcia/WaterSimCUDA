if(NOT IS_ABSOLUTE "${TEST_EXE}" OR NOT IS_ABSOLUTE "${OUTSIDE_DIR}")
    message(FATAL_ERROR "TEST_EXE and OUTSIDE_DIR must be absolute")
endif()
file(MAKE_DIRECTORY "${OUTSIDE_DIR}")
function(run_isolated executable group)
    if(NOT IS_ABSOLUTE "${executable}" OR NOT EXISTS "${executable}")
        message(FATAL_ERROR "Missing absolute runtime executable: ${executable}")
    endif()
    set(arguments)
    if(NOT group STREQUAL "")
        list(APPEND arguments "${group}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env
        --unset=CUDA_PATH --unset=CUDA_PATH_V13_4
        "PATH=$ENV{SystemRoot}/System32;$ENV{SystemRoot}" "CUDA_CACHE_DISABLE=1"
        "WATER_VALIDATE_DRIVE=1" "WATER_VALIDATE_WARMUP=0" "WATER_VALIDATE_SECONDS=0.2"
        "${executable}" ${arguments}
        WORKING_DIRECTORY "${OUTSIDE_DIR}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    message(STATUS "${executable} ${group}: ${result}\n${output}${error}")
    if(NOT result STREQUAL "0")
        message(FATAL_ERROR "Isolated runtime failed: ${executable} ${group}: ${result}")
    endif()
endfunction()
run_isolated("${TEST_EXE}" fft)
if(DEFINED DEMO_EXE)
    run_isolated("${DEMO_EXE}" "")
endif()
foreach(pair "INTEROP_EXE|interop" "BOAT_INTEROP_EXE|boat_interop" "APPEARANCE_EXE|appearance")
    string(REPLACE "|" ";" values "${pair}")
    list(GET values 0 variable)
    list(GET values 1 group)
    if(DEFINED ${variable})
        run_isolated("${${variable}}" "${group}")
    endif()
endforeach()
