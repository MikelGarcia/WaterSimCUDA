# CUDA 13.4.3 x64 ordinary cuFFT runtime; verified imports/startup are documented in docs/build-environment.md.
set(WATER_CUDA_RUNTIME_DLLS "${CUDAToolkit_BIN_DIR}/x64/cufft64_12.dll")
foreach(dll IN LISTS WATER_CUDA_RUNTIME_DLLS)
    if(NOT EXISTS "${dll}")
        message(FATAL_ERROR "Missing CUDA x64 runtime: ${dll}")
    endif()
    file(READ "${dll}" pe_offset OFFSET 60 LIMIT 4 HEX)
    string(SUBSTRING "${pe_offset}" 0 2 b0)
    string(SUBSTRING "${pe_offset}" 2 2 b1)
    string(SUBSTRING "${pe_offset}" 4 2 b2)
    string(SUBSTRING "${pe_offset}" 6 2 b3)
    math(EXPR machine_offset "0x${b3}${b2}${b1}${b0}+4")
    file(READ "${dll}" machine OFFSET ${machine_offset} LIMIT 2 HEX)
    if(NOT machine STREQUAL "6486")
        message(FATAL_ERROR "Expected x64 PE runtime, found machine ${machine}: ${dll}")
    endif()
endforeach()
function(water_deploy_cuda_runtime target)
    foreach(dll IN LISTS WATER_CUDA_RUNTIME_DLLS)
        add_custom_command(TARGET ${target} POST_BUILD
            COMMAND ${CMAKE_COMMAND} -E copy_if_different "${dll}" "$<TARGET_FILE_DIR:${target}>"
            VERBATIM)
    endforeach()
endfunction()
